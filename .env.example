# Synthcast — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. It's in .gitignore already.
# ─────────────────────────────────────────────────────────────

# ── LLM Provider (choose one) ─────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-key-here...

# Alternative: Anthropic Claude
# Get your key at: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...your-key-here...

# Which provider to use: "openai" | "anthropic" | "mock"
LLM_PROVIDER=mock

# ── ElevenLabs TTS ────────────────────────────────────────────
# Get your key at: https://elevenlabs.io (free tier: 10k chars/mo)
ELEVENLABS_API_KEY=...your-key-here...

# Your cloned voice ID (run tts.clone_voice() once to get this)
# Leave blank to use a preset voice (adam, bella, rachel, etc.)
ELEVENLABS_VOICE_ID=

# ── Creator Identity ──────────────────────────────────────────
CREATOR_NAME=Your Name
AVATAR_NAME=AI Your Name
CREATOR_PERSONALITY=confident, warm, direct, never sarcastic

# ── TikTok Live API (YOUR PART — see README) ──────────────────
# Step 1: Apply for TikTok Developer account at developers.tiktok.com
# Step 2: Create an app, request Live API permission
# Step 3: OAuth your creator account, paste the session token below
# Leave blank to run in simulation mode (fake comments for testing)
TIKTOK_SESSION_ID=
TIKTOK_UNIQUE_ID=@yourhandle

# ── Memory Backend ────────────────────────────────────────────
# "memory" = in-session only (MVP)
# "redis"  = persistent across restarts (Phase 2)
MEMORY_BACKEND=memory

# Redis URL (only needed if MEMORY_BACKEND=redis)
# REDIS_URL=redis://localhost:6379

# ── Server Config ─────────────────────────────────────────────
SYNTHCAST_API_URL=http://localhost:8000
POLL_INTERVAL=2.0
